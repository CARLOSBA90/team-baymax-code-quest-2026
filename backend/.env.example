# Neon (Dashboard, botón Connect)
# DATABASE_URL: conexión con pooler (host con "-pooler"), la usa la app en runtime.
# DIRECT_URL: conexión directa (sin "-pooler"), la usa Prisma CLI para migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Better Auth
# Secreto de al menos 32 caracteres. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de este backend (sin /api/auth).
BETTER_AUTH_URL=http://localhost:3001

# Discord OAuth (Developer Portal, sección OAuth2)
# Redirect URI a registrar: http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth (Google Cloud Console, Credentials)
# Redirect URI a registrar: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings, Developer settings, OAuth Apps)
# Redirect URI a registrar: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exige verificar el email antes de iniciar sesión; solo el valor true la activa.
REQUIRE_EMAIL_VERIFICATION=false

# Solo desarrollo: devuelve la URL de verificación en el header X-Verification-Url.
# NUNCA activar en producción. Para dev usar: true
EXPOSE_VERIFICATION_URL=false

# App
# Con production las cookies de sesión pasan a SameSite=None y Secure.
NODE_ENV=development
# Orígenes permitidos para CORS y Better Auth, separados por comas.
TRUSTED_ORIGINS=http://localhost:5173
PORT=3001
# Emails con permiso de administrador, separados por comas; vacío deniega a todos.
# Los administradores deben entrar con Discord o tener el correo verificado.
ADMIN_EMAILS=

# Roadmap generator. RULES is deterministic and requires no external service.
ROADMAP_GENERATOR_PROVIDER=RULES
ROADMAP_GENERATOR_FALLBACKS=RULES
# NVIDIA hosted API or an OpenAI-compatible self-hosted NIM base URL.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Models separated by commas. NVIDIA_MODEL remains supported.
NVIDIA_MODELS=
# The first NVIDIA_MAX_ATTEMPTS models run in parallel; the first valid plan
# wins and the others are cancelled. Each model gets
# min(NVIDIA_TIMEOUT_MS, NVIDIA_TOTAL_TIMEOUT_MS).
NVIDIA_TIMEOUT_MS=30000
NVIDIA_TOTAL_TIMEOUT_MS=30000
NVIDIA_MAX_ATTEMPTS=2
# Responses are streamed. A request with no first chunk after this time is
# considered stuck in the shared provider queue and is sent again, up to
# NVIDIA_QUEUE_RETRIES times (also on HTTP 429/5xx), within the model budget.
NVIDIA_FIRST_TOKEN_TIMEOUT_MS=10000
NVIDIA_QUEUE_RETRIES=2

# Private local storage for challenge file drafts. Use a mounted persistent
# directory in deployed environments; never serve this directory publicly.
CHALLENGE_UPLOAD_DIR=.data/challenge-submissions
